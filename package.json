{
  "name": "meetmap",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first desktop meeting assistant for meeting capture, transcription, summaries, and maps.",
  "packageManager": "pnpm@10.30.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "dev:demo": "pnpm build && electron . --meetmap-demo",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "package:win": "pnpm build && dotnet publish native/windows-audio/src/MeetMap.WindowsAudio.csproj -c Release && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.meetmap.desktop",
    "productName": "MeetMap",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/windows-audio/src/bin/Release/net8.0-windows/win-x64/publish",
        "to": "native/windows-audio",
        "filter": [
          "meetmap-windows-audio.exe"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "docx": "^9.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^39.2.5",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
